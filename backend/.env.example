# =============================================================================
# WALLET SYSTEM ENVIRONMENT CONFIGURATION
# Shared configuration for WalletSystem.Api and WalletSystem.Worker.Mail
# =============================================================================

# -----------------------------------------------------------------------------
# MESSAGING CONFIGURATION
# Options: InMemory (for development/testing) or RabbitMQ (for production)
# -----------------------------------------------------------------------------
Messaging__Mode=InMemory

# RabbitMQ Configuration (used when Messaging__Mode=RabbitMQ)
# Both Api and Worker.Mail use these settings for MassTransit communication
RabbitMQSettings__Host=event-bus-server
RabbitMQSettings__Port=5672
RabbitMQSettings__Username=guest
RabbitMQSettings__Password=guest
RabbitMQSettings__VirtualHost=/

# -----------------------------------------------------------------------------
# CACHE CONFIGURATION
# Used by WalletSystem.Api for caching
# Supported providers: Redis, Memory, File, Memcached
# - Redis: Requires a running Redis server (default)
# - Memory: In-memory cache (lost on restart, single-instance only)
# - File: Persistent file-based cache (survives restarts, local dev only)
# - Memcached: Requires a running Memcached server (high-performance distributed cache)
# -----------------------------------------------------------------------------
Cache__Provider=Redis
Cache__RedisConnection=cache-server:6379
# Cache__FileDirectory=/tmp/wallet-cache  # Optional: custom directory for file cache

# Memcached Configuration (only used when Cache__Provider=Memcached)
# Servers can be comma-separated list: "localhost:11211,server2:11211"
# Cache__Memcached__Servers=localhost:11211

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# Used by WalletSystem.Api for Entity Framework Core
# DefaultConnection: SQLite for development, MySQL for production
# -----------------------------------------------------------------------------
ConnectionStrings__DefaultConnection=Data Source=walletsystem.db
ConnectionStrings__MySqlConnection=Server=localhost;Database=WalletSystem;User=root;Password=password;

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION CONFIGURATION
# Used by WalletSystem.Api for token generation and validation
# -----------------------------------------------------------------------------
JwtSettings__SecretKey=YourSuperSecretKeyThatIsAtLeast32CharactersLong!
JwtSettings__Issuer=WalletSystem.Api
JwtSettings__Audience=WalletSystem.Users
JwtSettings__ExpirationMinutes=60
JwtSettings__RefreshTokenDays=7

# -----------------------------------------------------------------------------
# SMTP CONFIGURATION
# Used by both WalletSystem.Api (notifications) and WalletSystem.Worker.Mail
# Default values are for Mailpit (development SMTP server)
# -----------------------------------------------------------------------------
SmtpSettings__Host=smtp-server
SmtpSettings__Port=1025
SmtpSettings__Username=
SmtpSettings__Password=
SmtpSettings__EnableSsl=false
SmtpSettings__From=noreply@walletsystem.com
SmtpSettings__FromName=WalletSystem

# -----------------------------------------------------------------------------
# ADMIN NOTIFICATION SETTINGS
# Used by WalletSystem.Api for admin notifications
# -----------------------------------------------------------------------------
AdminNotification__Enabled=true
AdminNotification__EmailAddress=admin@walletsystem.com
