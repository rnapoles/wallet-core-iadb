# syntax=docker/dockerfile:1
# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

# Copy solution and project files
COPY *.sln ./
COPY WalletSystem.Api/WalletSystem.Api.csproj WalletSystem.Api/
COPY WalletSystem.Application/WalletSystem.Application.csproj WalletSystem.Application/
COPY WalletSystem.Demo.Client/WalletSystem.Demo.Client.csproj WalletSystem.Demo.Client/
COPY WalletSystem.Demo.Daemon/WalletSystem.Demo.Daemon.csproj WalletSystem.Demo.Daemon/
COPY WalletSystem.Demo.Shared/WalletSystem.Demo.Shared.csproj WalletSystem.Demo.Shared/
COPY WalletSystem.Domain/WalletSystem.Domain.csproj WalletSystem.Domain/
COPY WalletSystem.Infrastructure/WalletSystem.Infrastructure.csproj WalletSystem.Infrastructure/
COPY WalletSystem.Shared/WalletSystem.Shared.csproj WalletSystem.Shared/
COPY WalletSystem.Tests/WalletSystem.Tests.csproj WalletSystem.Tests/


# 1. Restore dependencies using a global NuGet cache mount
RUN --mount=type=cache,id=nuget,target=/root/.nuget/packages \
    dotnet restore WalletSystem.sln

# Copy everything else
COPY . .

# 2. Skip redundant intermediate "dotnet build" and compile via publish directly
# 3. Reuse the NuGet cache mount and add a compiler build cache (.nuget/plugins, obj, etc.)
# 4. Use --no-restore since the previous step completely restored the solution state
RUN --mount=type=cache,id=nuget,target=/root/.nuget/packages \
    dotnet publish "WalletSystem.Demo.Daemon/WalletSystem.Demo.Daemon.csproj" \
    -c Release \
    -o /app/daemon-publish \
    --no-restore \
    /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS final
WORKDIR /app

# Copy the build artifacts from the build stage directly
COPY --from=build /app/daemon-publish .

# Set entry point to run the daemon
ENTRYPOINT ["dotnet", "WalletSystem.Demo.Daemon.dll"]
