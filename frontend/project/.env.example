# Copy this file to .env and fill in real values for your environment.
# Only variables prefixed with VITE_ are exposed to client-side code by Vite —
# never put secrets (API keys, DB credentials) in this file, since anything
# here ends up readable in the compiled browser bundle.

# Base URL of the WalletSystem API (must be a valid absolute URL, e.g. https://api.example.com)
VITE_API_BASE_URL=https://localhost:5001

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=15000

# Display name used in the UI
VITE_APP_NAME=WalletSystem

# Set to "true" to log outgoing API requests to the browser console (development only)
VITE_ENABLE_API_LOGGING=false
