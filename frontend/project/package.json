{
  "name": "walletsystem-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "WalletSystem frontend — Clean Architecture / DDD React + TypeScript UI for the WalletSystem API.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "axios": "1.20.0",
    "clsx": "2.1.1",
    "framer-motion": "11.18.2",
    "lucide-react": "0.460.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "15.15.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
