# Supply-chain hardening for npm installs.

# Pin exact versions in package.json instead of ranges (^/~), so `npm install`
# can't silently pull a newer, potentially compromised transitive version.
save-exact=true

# Fail the install if any dependency has a preinstall/install/postinstall
# script, unless explicitly allow-listed. This blocks the most common supply
# chain attack vector (a compromised package running arbitrary code on
# install). Run `npm install` once with this commented out if a trusted
# dependency legitimately needs a build step, then re-enable it.
ignore-scripts=true

# Always install from the lockfile as-is; never let a routine install
# silently upgrade dependencies out from under the lockfile.
package-lock=true

# Audit automatically on install so new advisories surface immediately.
audit=true
